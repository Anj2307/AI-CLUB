# Copy to .env and fill in. Never commit .env.

NODE_ENV=production
PORT=3000

# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# First-boot admin account (only used when the database has no users yet).
# If ADMIN_PASSWORD is empty a random one is generated and printed in the logs once.
ADMIN_EMAIL=aiclub@iitdh.ac.in
ADMIN_NAME=Club Admin
ADMIN_PASSWORD=

# How long an admin stays signed in.
SESSION_HOURS=12

# Where the SQLite database and uploaded images live. Mount this as a volume.
DATA_DIR=/app/data
MAX_UPLOAD_MB=8

# Number of reverse proxies in front of the app (for correct client IPs / rate limits).
TRUST_PROXY=1

# Extra origins allowed to call the API, comma separated
# (only needed if the frontend is hosted separately, e.g. on GitHub Pages).
CORS_ORIGINS=

# Domain for automatic HTTPS when using the bundled Caddy proxy (docker compose --profile https).
DOMAIN=aiclub.example.com
